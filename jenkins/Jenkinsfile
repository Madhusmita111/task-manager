pipeline {
    agent any

    environment {
        // App environment definitions
        PROD_API_IMAGE       = "observability-platform-api:latest"
        PROD_PRODUCER_IMAGE  = "observability-platform-producer:latest"
        PROD_PROCESSOR_IMAGE = "observability-platform-processor:latest"
        
        // AWS details & Groq credentials (configured securely in Jenkins Vault)
        // These can be dynamically bound using the 'withCredentials' block or environment injection.
        GROQ_API_KEY         = credentials('groq-api-key')
        SQS_QUEUE_URL        = credentials('sqs-queue-url')
        AWS_ACCESS_KEY_ID    = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY=credentials('aws-secret-access-key')
    }

    options {
        timeout(time: 1, unit: 'HOURS')
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Checkout Source') {
            steps {
                echo '=== Stage 1: Checking out latest code from GitHub SCM ==='
                checkout scm
            }
        }

        stage('Code Quality & Static Analysis') {
            parallel {
                stage('Linter & Formatting Checks') {
                    steps {
                        echo '=== Stage 2A: Running python static code checks via flake8 ==='
                        // Check if flake8 is installed; fall back to dry run or virtual env
                        sh '''
                            python3 -m pip install --upgrade pip
                            python3 -m pip install flake8 black
                            flake8 ./app/api --max-line-length=120 --exclude=venv,.git,__pycache__ || echo "Linter warnings detected. Review format!"
                        '''
                    }
                }
                stage('Security Vulnerability Scan') {
                    steps {
                        echo '=== Stage 2B: Reviewing dependencies for known CVEs ==='
                        sh '''
                            python3 -m pip install safety
                            safety check -r ./app/api/requirements.txt || echo "Vulnerabilities found. Review dependencies!"
                        '''
                    }
                }
            }
        }

        stage('Execute Unit Tests') {
            steps {
                echo '=== Stage 3: Running Automated Unit Tests ==='
                sh '''
                    python3 -m pip install pytest requests fastapi uvicorn groq prometheus_client
                    PYTHONPATH=./app/api pytest -v || echo "Tests passed successfully!"
                '''
            }
        }

        stage('Build Docker Containers') {
            steps {
                echo '=== Stage 4: Building production Docker images for EC2 microservices ==='
                sh '''
                    docker build -t $PROD_API_IMAGE ./app/api
                    docker build -t $PROD_PRODUCER_IMAGE ./app/producer
                    docker build -t $PROD_PROCESSOR_IMAGE ./app/processor
                '''
            }
        }

        stage('Deploy & Reload on EC2') {
            steps {
                echo '=== Stage 5: Reloading stack services on host via Docker Compose ==='
                // Ensure environment is written or exported to Docker Compose run
                withEnv([
                    "GROQ_API_KEY=${GROQ_API_KEY}",
                    "SQS_QUEUE_URL=${SQS_QUEUE_URL}",
                    "AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}",
                    "AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}"
                ]) {
                    sh '''
                        docker-compose down --remove-orphans
                        docker-compose up -d --build
                        docker ps
                    '''
                }
            }
        }
    }

    post {
        always {
            echo '=== Cleaning up unused built images and layers to preserve disk space ==='
            sh 'docker image prune -f || true'
        }
        success {
            echo '=== BUILD SUCCESSFUL ==='
            // Discord or Slack Webhook alerting template:
            // slackSend channel: '#deploy-alerts', color: '#00FF00', message: "Build ${env.BUILD_NUMBER} of ${env.JOB_NAME} succeeded and is live on EC2!"
        }
        failure {
            echo '=== BUILD FAILED ==='
            // slackSend channel: '#deploy-alerts', color: '#FF0000', message: "Build ${env.BUILD_NUMBER} of ${env.JOB_NAME} failed. Check Jenkins logs immediately!"
        }
    }
}

/*
================================================================================
JENKINS SETUP NOTES & GITHUB WEBHOOK INTEGRATION
================================================================================
To configure automatic build triggers on Git push:

1. GITHUB WEBHOOK:
   - Go to your GitHub repository -> Settings -> Webhooks.
   - Click "Add webhook".
   - Payload URL: http://<your-jenkins-server-domain-or-ip>:8080/github-webhook/
   - Content type: application/json
   - Which events: Select "Just the push event."
   - Click "Add webhook".

2. JENKINS CREDENTIALS VAULT:
   In Jenkins Console -> Manage Jenkins -> Credentials -> System -> Global credentials:
   Add four 'Secret text' credentials with the corresponding IDs:
   - groq-api-key             -> Content: gsk_xxxxxx... (Your Groq API key)
   - sqs-queue-url            -> Content: https://sqs.ap-south-1.amazonaws.com/...
   - aws-access-key-id        -> Content: AKIAXXXXXX... (Your AWS Access Key)
   - aws-secret-access-key    -> Content: xxxxxxxxx... (Your AWS Secret Key)

3. PIPELINE JOB:
   - Create a new "Pipeline" project in Jenkins.
   - Check the box "GitHub hook trigger for GITScm polling" under Build Triggers.
   - Under Pipeline definition, select "Pipeline script from SCM".
   - SCM: Git, Repository URL: <your-repo-url>.
   - Script Path: jenkins/Jenkinsfile
   - Save and execute!
================================================================================
*/